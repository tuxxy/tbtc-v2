+    function spendAll(
+        BridgeState.Storage storage self,
+        bytes32 walletId,
+        bytes32 main,
+        bytes memory inputs
+    ) private returns (uint64 total) {
+        uint256 count = uint8(inputs[0]);
+        require(
+            count > 0 &&
+                count < 0xfd &&
+                inputs.length == 1 + count * 41 &&
+                inputKey(inputs, 1) == main,
+            "FROST movement input"
+        );
+        for (uint256 i = 0; i < count; i++) {
+            uint256 offset = 1 + i * 41;
+            bytes32 key = inputKey(inputs, offset);
+            FrostCustody.Output storage output = self.frostCustody.outputs[key];
+            require(
+                inputs[offset + 36] == 0x00 &&
+                    output.walletId == walletId &&
+                    !output.spent &&
+                    !self.spentMainUTXOs[uint256(key)],
+                "FROST movement input"
+            );
+            output.spent = true;
+            self.spentMainUTXOs[uint256(key)] = true;
+            total += output.value;
+        }
+    }
+
     function inputKey(bytes memory inputs, uint256 offset)
