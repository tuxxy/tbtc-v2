diff --git a/solidity/contracts/frost/FrostFundingTarget.sol b/solidity/contracts/frost/FrostFundingTarget.sol
new file mode 100644
index 00000000..0073e996
--- /dev/null
+++ b/solidity/contracts/frost/FrostFundingTarget.sol
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-3.0-only
+pragma solidity 0.8.17;
+
+import "./FrostWallets.sol";
+
+/// @notice Wallet-level FROST funding-target rule, shared by the view and
+/// deposit admission.
+library FrostFundingTarget {
+    function admitsDeposits(FrostWallets.Wallet storage w)
+        public
+        view
+        returns (bool)
+    {
+        if (w.quarantined || w.capabilityVersion == 0) return false;
+        FrostWallets.State s = w.state;
+        return
+            s == FrostWallets.State.Live ||
+            s == FrostWallets.State.ReadyUnfunded;
+    }
+}
